{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix server && npm ci --prefix client && npm --prefix server run prisma:generate",
  "buildCommand": "VITE_API_BASE_URL= npm --prefix client run build",
  "outputDirectory": "client/dist",
  "framework": null,
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/**": {
      "includeFiles": "server/{node_modules/zxing-wasm/dist/reader/*.wasm,tessdata/*}",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path]"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance/sweep-orphans",
      "schedule": "0 3 * * *"
    }
  ]
}
