# Fill this in, then rename to server/.env.production (which is gitignored).
# Paste the real values here rather than into the chat, so they stay off the
# transcript. I read the file without printing it.

# Neon: Project → Connection Details → the POOLED connection string.
# Serverless opens a connection per invocation, so the pooled one matters.
DATABASE_URL=""

# Cloudflare R2: R2 → your bucket → Manage API tokens → Create API token
# (Object Read & Write). The endpoint looks like
# https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# The first staff login for the client to try. At least 12 characters.
SEED_STAFF_EMAIL="admin@hotel.local"
SEED_STAFF_PASSWORD=""
