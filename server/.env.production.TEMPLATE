# Fill in the blanks, then rename this file to:  server/.env.production
# That name is gitignored (verified). Keep the values here rather than in chat.
#
# ============================================================================
# EASIEST ROUTE: one Supabase project gives you BOTH the database and the
# S3-compatible bucket. Free, no payment method. supabase.com -> New project.
# ============================================================================
#
# --- 1. DATABASE -----------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> URI,
#   and tick "Use connection pooling" (Transaction mode, port 6543).
#   Pooling matters: serverless opens a connection per invocation.
#   Replace [YOUR-PASSWORD] with the database password you set at project
#   creation.
#
# (Using Neon instead? Project -> Connection Details -> the POOLED string.)
DATABASE_URL=""

# --- 2. ID PHOTO STORAGE ---------------------------------------------------
# Supabase: Storage -> create a bucket named 'id-documents', keep it PRIVATE.
#   Then Project Settings -> Storage -> S3 access keys -> New access key.
#   The endpoint is shown on that page and looks like:
#     https://<project-ref>.supabase.co/storage/v1/s3
#   The region is your project's region, e.g. ap-south-1.
#
# (Using Cloudflare R2 instead? R2 -> create private bucket -> Manage API
#  tokens -> Object Read & Write. Region is literally "auto"; endpoint is
#  https://<accountid>.r2.cloudflarestorage.com)
STORAGE_DRIVER="s3"
S3_BUCKET="id-documents"
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- 3. STAFF LOGIN --------------------------------------------------------
# Generated for you. This is what the client signs in with. Change it if you
# prefer something memorable - minimum 12 characters.
SEED_STAFF_EMAIL="admin@hotel.local"
SEED_STAFF_PASSWORD="2KfTT3GcRgYoQ3Aa1!"
SEED_STAFF_NAME="Front Desk Admin"
