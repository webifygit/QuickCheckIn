# Neon (or any) Postgres connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign staff JWTs - generate a long random string
JWT_SECRET="change-this-to-a-long-random-string"

PORT=4000

# Used only by `npm run seed` to create the first staff login
SEED_STAFF_EMAIL="admin@hotel.local"
SEED_STAFF_PASSWORD="ChangeMe123!"
SEED_STAFF_NAME="Front Desk Admin"
