# Copy to .env and fill in. The server validates every value at boot and exits
# with a readable message rather than starting in a broken state.

# --- core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Any Postgres connection string (Neon, RDS, a container, ...).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs staff session tokens. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="replace-with-at-least-32-random-characters-not-this"

# How long a staff session lasts. Verification never hits the database, so a
# disabled account keeps access until its token expires - shorten this if you
# need revocation to bite sooner.
JWT_EXPIRES_IN=12h

# --- who may call this API --------------------------------------------------
# Comma-separated origins. A wildcard is refused in production: this API serves
# personal ID data, and reflecting any origin would let any site drive it using
# a signed-in reviewer's browser.
CORS_ORIGINS=http://localhost:5173

# Number of proxy hops to trust for the client IP (X-Forwarded-For).
# 0 = no proxy. 1 = one nginx/load balancer in front. Rate limiting is only as
# honest as this number: set it too high and clients can forge their own IP.
TRUST_PROXY_HOPS=0

# --- uploaded ID images -----------------------------------------------------
# local = a directory on disk. Only safe where that disk survives a restart.
# s3    = any S3-compatible bucket. Required on ephemeral-disk platforms.
STORAGE_DRIVER=local
UPLOAD_DIR=

# Only read when STORAGE_DRIVER=s3. Keep the bucket private - the app streams
# images through an authenticated route and never hands out object URLs.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAX_UPLOAD_BYTES=8388608

# An image uploaded by a guest who then abandoned the form is referenced by
# nothing. Those are swept after this many minutes.
ORPHAN_UPLOAD_TTL_MINUTES=120

# --- scheduled maintenance (serverless only) ----------------------------------
# Only on a platform with no long-lived process, where the orphan sweep runs
# from a scheduled request instead of an interval. The endpoint deletes stored
# objects, so without this set the route is not mounted at all. 24+ characters.
#   openssl rand -base64 32
CRON_SECRET=

# --- rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15

# Both of these are per-IP, and guests fill the form on the hotel's wifi - so
# one budget covers an entire afternoon's arrivals, not one guest. Raise them
# further for a large property.
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_SCAN_MAX=120

# Not a capacity limit - this one exists to slow password guessing, and a
# successful sign-in does not count against it.
RATE_LIMIT_LOGIN_MAX=10

# Signed-in staff, counted per account rather than per IP - a front desk behind
# one NAT address must not share a single quota. Reviewing one guest costs about
# three calls (open, load the ID image, save).
RATE_LIMIT_STAFF_MAX=600

# --- logging ----------------------------------------------------------------
LOG_LEVEL=info

# --- first staff login ------------------------------------------------------
# Used only by `npm run seed`, and only when the account does not already exist.
# Re-running seed never resets a password staff have since changed.
SEED_STAFF_EMAIL="admin@hotel.local"
SEED_STAFF_PASSWORD=""
SEED_STAFF_NAME="Front Desk Admin"
