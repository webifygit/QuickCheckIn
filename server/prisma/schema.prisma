generator client {
  provider = "prisma-client-js"
  // "native" covers local development and the Docker image. Vercel's functions
  // run on Amazon Linux with OpenSSL 3, and Prisma ships a separate engine for
  // it - without this the deployed function fails at query time with
  // "Query engine library for current platform could not be found".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdType {
  AADHAAR
  // PAN is one of the commonest IDs presented at an Indian front desk. Without
  // it, a guest holding one has to file themselves under OTHER.
  PAN
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
  OTHER
}

enum RegistrationStatus {
  PENDING
  APPROVED
  CHECKED_IN
  REJECTED
}

model StaffUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  isActive     Boolean        @default(true)
  // Bumped to invalidate every token already issued to this account - a
  // password reset, or "sign this person out now". Tokens carry the value
  // they were minted with, so an older one no longer matches.
  tokenVersion Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  reviewed     Registration[] @relation("ReviewedBy")
}

model Registration {
  id             String  @id @default(cuid())
  fullName       String
  dob            String?
  gender         String?
  nationality    String?
  idType         IdType  @default(AADHAAR)
  // Aadhaar is stored masked ("XXXX XXXX 1234"). Full numbers are never persisted.
  idNumber       String?
  address        String?
  phone          String
  email          String?
  checkInDate    DateTime?
  checkOutDate   DateTime?
  purposeOfVisit String?
  vehicleNumber  String?
  numberOfGuests Int     @default(1)

  // Opaque key into the storage driver - not a URL and not a filesystem path.
  // The image is purged once staff approve, and idDocumentDeletedAt records that
  // it existed and was disposed of, which is what an audit actually needs.
  idDocumentKey       String?
  idDocumentDeletedAt DateTime?

  status       RegistrationStatus @default(PENDING)
  consentGiven Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewedByStaffId String?
  reviewedAt        DateTime?
  reviewedByStaff   StaffUser? @relation("ReviewedBy", fields: [reviewedByStaffId], references: [id])

  // The dashboard always reads newest-first, optionally filtered by status.
  @@index([status, createdAt])
  @@index([createdAt])
}
